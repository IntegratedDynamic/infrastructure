terraform {
  # Migrated to the dedicated Scaleway state bucket (00-foundation/scaleway,
  # state_buckets["vpn_wireguard_site_to_site"]).
  #
  # Prefix + workspace name now mirror this root's own path (2026-08-24
  # workspace-naming refacto) — used to be "network/wireguard" /
  # "04-network-wireguard", leftover from before this root was renamed from
  # wireguard/ to wireguard-site-to-site/. No terraform.workspace naming
  # coupling here (pure local keypair generation), so this is a plain state
  # relocation, zero resource impact. Old state object left in place under
  # the old prefix/workspace, orphaned on purpose (never deleted).
  #
  # Terragrunt migration: the `backend "s3"` block that used to sit here is now
  # generated by live/root.hcl — same bucket, and the former workspace
  # "04-vpn-wireguard-site-to-site-dev" (state at 04-vpn/wireguard-site-to-site/04-vpn-wireguard-site-to-site-dev/terraform.tfstate)
  # is now the key of the default workspace: the same object, nothing moved.
  # Run this root through `terragrunt` from live/dev/04-vpn/wireguard-site-to-site, not bare `tofu`.

  required_providers {
    # Pulled in by OpenTofu's s3 state backend (unlike Terraform's, its
    # backend depends on the AWS provider); not used directly by this root.
    # Constraint kept in step with the real-AWS roots (00-foundation/aws etc.).
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    wireguard = {
      source  = "OJFord/wireguard"
      version = "~> 0.4"
    }
  }
}

# Pure local keypair generation — no API, no credentials to configure.
provider "wireguard" {}
