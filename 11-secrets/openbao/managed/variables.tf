# --- Full contents of every kv/apps/* secret object this root reconciles.
# Some fields are arbitrary (Terraform could generate them) and some are
# externally issued (GitHub App/OAuth credentials) — both kinds live in these
# same maps, one variable per KV object, because that's the natural unit of
# "what's this secret" and it matches the object Vault itself stores. Never
# committed — populated in a gitignored local.auto.tfvars.

# Mirrors 10-cluster/scaleway's var.letsencrypt_staging (see that variable's
# own comment for the full "why") -- kept as an independent variable in this
# root rather than a cross-root terraform_remote_state read of that one,
# same "two roots' TEMPORARY overrides kept manually in sync" pattern this
# flag already used historically (see git history: 98f87ce/74e37e4 added
# rootCA/oidc_discovery_ca_pem together across both repos, 8fc3c74/3ff54d4
# removed them together). Only consumed by vault_jwt_auth_backend.oidc's own
# oidc_discovery_ca_pem below -- OpenBao's pod itself needs no CA/volume/init
# container changes at all, since this field lets OpenBao trust a CA for
# just this one auth backend's own outbound OIDC discovery call, entirely
# server-side, independent of the pod's system trust store.
variable "letsencrypt_staging" {
  type        = bool
  default     = false
  description = "Use Let's Encrypt staging's root CA for OpenBao's own OIDC discovery call to sso.staging.scalepack.fr (vault_jwt_auth_backend.oidc), matching 10-cluster/scaleway's var.letsencrypt_staging when that root's gateway-config runs letsencrypt-staging instead of letsencrypt-prod."
}

# privateKey.pem is the GitHub App's private key, downloaded from GitHub —
# external, not generatable.
variable "secrets_sync_github_eso_private_key" {
  description = "Full contents of kv/apps/secrets-sync/github/eso-github-app-private-key."
  type        = map(string)
  sensitive   = true
}

# Slack bot token (xoxb-...) for the workspace-events Sensor's Slack notification
# (kv/apps/workspace-events/slack). Issued by Slack, so not generatable. Set in the
# gitignored local.auto.tfvars of whoever applies this root by hand. It has a
# placeholder default on purpose: the unattended Crossplane Workspace applies this
# same root without it, and must keep working (the resource ignores later changes,
# see main.tf -- push a new value with `-replace=vault_kv_secret_v2.workspace_events_slack`).
variable "slack_event_bot_token" {
  description = "Slack bot token (xoxb-...) written to kv/apps/workspace-events/slack."
  type        = string
  sensitive   = true
  default     = "REPLACE_ME"
}

# GitHub OAuth App behind authentik's "GitHub" login source (infra issue #135):
# EXTERNAL secrets (issued by GitHub, not generatable), so they live in
# kv/apps/authentik/credentials and are Terraform-owned, unlike authentik's
# internal random secrets (kv/apps/authentik/eso-generated, generated by ESO).
# Create the app under the IntegratedDynamic org with callback URL
# https://sso.<domain>/source/oauth/callback/github/ , then set both values in
# the gitignored local.auto.tfvars of whoever applies this root by hand. Same
# placeholder-default convention as slack_event_bot_token above: the unattended
# Crossplane Workspace applies this root without them and must keep working
# (the resource ignores later changes, see main.tf -- push real values with
# `-replace=vault_kv_secret_v2.authentik_github`).
variable "authentik_github_client_id" {
  description = "Client ID of the GitHub OAuth App, written to kv/apps/authentik/credentials (github-client-id)."
  type        = string
  default     = "REPLACE_ME"
}

variable "authentik_github_client_secret" {
  description = "Client secret of the GitHub OAuth App, written to kv/apps/authentik/credentials (github-client-secret)."
  type        = string
  sensitive   = true
  default     = "REPLACE_ME"
}

# Structured so the scope of each secret is explicit in code, not just
# encoded as an opaque KV path string — a GitHub repo/environment rename is a
# map-key rename here, not a hunt through hardcoded path segments.
# Mirrors the gitops repo's apps/secrets-sync/values.yaml `targets` shape
# (global org-wide secrets vs per-repo vs per-repo-per-environment), though
# that chart's `targets[].repository`/`.environment` still need updating too
# on a rename — these are two independent systems kept in sync by convention.
#
#   global                        -> kv/apps/secrets-sync/github/global
#   repos["<repo>"].secrets        -> kv/apps/secrets-sync/github/<repo>
#   repos["<repo>"].environments["<env>"] -> kv/apps/secrets-sync/github/<repo>-<env>
#
# SCW_ACCESS_KEY/SCW_SECRET_KEY under repos.infrastructure.environments.scaleway
# are NOT supplied here — main.tf merges those in from
# data.terraform_remote_state.dns_scaleway instead. WireGuard's keys are the
# same story: read straight from data.terraform_remote_state.wireguard, no
# variable needed.

variable "secrets_sync_github" {
  description = "GitHub secrets-sync content (kv/apps/secrets-sync/github/*), scoped by org/repo/repo+environment."
  type = object({
    global = optional(map(string), {})
    repos = optional(map(object({
      secrets      = optional(map(string), {})
      environments = optional(map(map(string)), {})
    })), {})
  })
  sensitive = true
}

# Mirrors 10-cluster/scaleway's var.domain -- this root hardcoded
# auth.staging.scalepack.fr / openbao.staging.scalepack.fr directly in
# vault_jwt_auth_backend.oidc/vault_jwt_auth_backend_role below until this
# variable existed. Kept as an independent variable in this root (same
# "two roots' values kept manually in sync" pattern var.letsencrypt_staging
# above already uses) rather than a cross-root terraform_remote_state read,
# since there's no dedicated output in 10-cluster/scaleway for it and this
# is a plain string, not a secret. No default on purpose, same reasoning as
# that root's own var.domain.
variable "domain" {
  description = "The platform's base public domain (e.g. \"staging.scalepack.fr\") -- must match 10-cluster/scaleway's own var.domain for this cluster."
  type        = string
}

# See version.tf's provider "vault" block for the three real addresses this
# resolves to (in-cluster Service / port-forward / public route) and which
# execution context uses each.
variable "vault_address" {
  description = "Address the vault provider authenticates against."
  type        = string
  default     = "http://openbao.openbao.svc:8200/"
}

