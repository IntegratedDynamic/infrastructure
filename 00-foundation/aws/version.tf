terraform {
  # The state backend is generated by live/root.hcl, like every other root's
  # (Scaleway bucket id-terraform-state-00-foundation-aws). It used to live in
  # the AWS bucket this root manages, at
  # 00-foundation/aws/00-foundation-aws-dev/terraform.tfstate; that object is
  # left there as a rollback copy. Run through `terragrunt` from
  # live/dev/00-foundation/aws, never bare `tofu`.

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    # Pulled in transitively by module.iam_oidc_provider (fetches GitHub's
    # OIDC thumbprint dynamically instead of a hardcoded value).
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
  }
}

# Credentials are resolved by the AWS SDK chain — NOT hardcoded here:
#   - local: `aws sso login` -> The provider will default on your sso session
#   - CI:    GitHub OIDC -> aws-actions/configure-aws-credentials sets env vars, which will default there too.

# Any environment with ~/.aws or AWS_* env vars properly configured will work
provider "aws" {
  region  = var.region
  profile = var.aws_profile
}
