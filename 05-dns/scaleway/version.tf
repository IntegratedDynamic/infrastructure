terraform {
  # The backend is generated by live/root.hcl. Run this root through
  # `terragrunt` from live/core/main/05-dns/scaleway, never bare `tofu`.
  # The identity came from 01-iam/workload/scaleway (moved between states, not
  # recreated, so its API key did not change).

  required_providers {
    # Pulled in by OpenTofu's s3 state backend (unlike Terraform's, its
    # backend depends on the AWS provider); not used directly by this root.
    # Constraint kept in step with the real-AWS roots (00-foundation/aws etc.).
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    scaleway = {
      source  = "scaleway/scaleway"
      version = "~> 2.0"
    }
    time = {
      source  = "hashicorp/time"
      version = "~> 0.12"
    }
  }
}

# Creds, region and project_id come from the scw CLI config (like the other roots).
provider "scaleway" {}
